<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wbendinelli.scholar-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/wbendinelli/Documents/wbendinelli/scripts/.venv/bin/python</string>
        <string>/Users/wbendinelli/Documents/wbendinelli/scripts/update_scholar.py</string>
        <string>--write</string>
        <string>--commit</string>
        <string>--push</string>
    </array>

    <!-- Segunda-feira, 9h. O Scholar atualiza devagar; semanal é de sobra. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/wbendinelli/Documents/wbendinelli</string>

    <key>StandardOutPath</key>
    <string>/Users/wbendinelli/Documents/wbendinelli/scripts/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wbendinelli/Documents/wbendinelli/scripts/launchd.err.log</string>
</dict>
</plist>
